TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui

# API Key de Google Gemini (opcional: si se omite, usa el motor clínico integrado del TFM)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Ruta opcional de la base de datos SQLite
BITACORA_DB_PATH=bitacora_tea.db
